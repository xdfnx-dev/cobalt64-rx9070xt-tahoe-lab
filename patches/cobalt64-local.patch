+#pragma once
+#include <stdint.h>
+
+// DCN4.1 dccg401_set_dp_dto: pixelHz = integer*modulo + phase.
+// DPDTO0_INT occupies bits 4:1 of OTG_PIXEL_RATE_DIV. These helpers do no I/O.
+// Reference: Linux 238650ef6c7c dc/dccg/dcn401/dcn401_dccg.c.
+static inline uint64_t n48dto0_decode(uint32_t cntl,uint32_t phase,uint32_t modulo,uint32_t rate)
+{
+    if (cntl==0xffffffffu || phase==0xffffffffu || modulo==0xffffffffu || rate==0xffffffffu ||
+        !(cntl&0x10u) || !modulo || phase>=modulo) return 0;
+    return (uint64_t)((rate&0x1eu)>>1)*modulo+phase;
+}
+static inline bool n48dto0_encode(uint64_t pixelHz,uint32_t referenceHz,uint32_t oldRate,
+                                 uint32_t *phase,uint32_t *modulo,uint32_t *rate)
+{
+    if (!phase || !modulo || !rate || !pixelHz || !referenceHz || referenceHz==0xffffffffu ||
+        oldRate==0xffffffffu || pixelHz/referenceHz>15u) return false;
+    uint32_t integer=(uint32_t)(pixelHz/referenceHz);
+    *phase=(uint32_t)(pixelHz-(uint64_t)integer*referenceHz);
+    *modulo=referenceHz;
+    *rate=(oldRate&~0x1eu)|(integer<<1);
+    return true;
+}
