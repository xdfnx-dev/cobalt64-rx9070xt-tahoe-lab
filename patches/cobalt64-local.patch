+++ b/src/navi48-bringup/src/dcn/navi48_fwmeta_scan.h
@@ -0,0 +1,36 @@
+#pragma once
+#include <stdint.h>
+// A bounded metadata-candidate reader, never a firmware-ABI admission rule.
+// E.read uses Cobalt64's serialized MM_INDEX reader. No command submission.
+namespace n48fw {
+enum Status:uint32_t { Found=0, InvalidRange=1, ReadFailed=2, NotFound=3, Deadline=4 };
+struct Result { uint32_t status=InvalidRange,chunks=0;uint64_t address=0;uint32_t words[8]={}; };
+template<class E> Result scan(E&e,uint64_t anchor,uint64_t vramSize){
+ Result r;
+ const uint64_t limit=0x100000;
+ if(anchor<256 || anchor>vramSize || (anchor&3))return r;
+ const uint64_t begin=anchor>limit?anchor-limit:0;
+ const uint64_t started=e.now_us();
+ for(uint64_t high=anchor;high>begin;){
+  if(e.now_us()-started>2000000ull){r.status=Deadline;return r;}
+  const uint32_t n=(uint32_t)((high-begin>=256?256:high-begin)/4);
+  const uint64_t low=high-(uint64_t)n*4;
+  uint32_t w[64]={};
+  if(!e.read(low,w,n)){r.status=ReadFailed;return r;}
+  ++r.chunks;
+  for(uint32_t k=n;k-->0;){
+   if(w[k]!=0x444d5542u)continue;
+   uint64_t at=low+(uint64_t)k*4;
+   if(anchor-at<32)continue;
+   uint32_t m[8]={};
+   if(!e.read(at,m,8)){r.status=ReadFailed;return r;}
+   // A matching version does NOT establish identical image or VBIOS ABI.
+   if(m[0]!=0x444d5542u || !m[3] || m[3]==0xffffffffu || (m[4]&255)>1)continue;
+   for(unsigned j=0;j<8;j++)r.words[j]=m[j];
+   r.address=at;r.status=Found;return r;
+  }
+  high=low;
+ }
+ r.status=NotFound;return r;
+}
+}
